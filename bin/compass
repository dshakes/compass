#!/usr/bin/env bash
# compass — one CLI for compass's local tools. Put bin/ on your PATH, or call
# ~/compass/bin/compass directly. Each subcommand is a script in ../scripts.
set -euo pipefail

# Resolve through symlinks (we're installed as ~/.local/bin/compass -> <repo>/bin/compass)
# so the repo root — and scripts/ — is found no matter how compass is invoked.
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  dir="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$dir/$SRC" ;; esac
done
HERE="$(cd -P "$(dirname "$SRC")" && pwd)"
# COMPASS_REPO_ROOT lets a packaged install (e.g. Homebrew) pin the repo root to a
# stable path that survives upgrades. Unset → resolve from our own location (git clone).
ROOT="${COMPASS_REPO_ROOT:-$(dirname "$HERE")}"
SCRIPTS="$ROOT/scripts"

cmd="${1:-help}"; [ "$#" -gt 0 ] && shift

usage() {
  cat <<EOF
compass — local engineering tools

usage: compass <command> [args]

  quickstart [flags]       Install + validate + the 60-second on-ramp (idempotent;
                           re-run to repair). Pass-through: --mcp --gemini --copy --yes.
  status  [DIR]            Is compass enabled here? Global config + this-repo extras.
  drift   [--json]         Does the installed config still match the repo source?
                           Catches clobbered/stale/hand-edited installs + non-+x hooks.
  onboard [DIR] | --all <glob>
                           Onboard into a repo: detect stack, deps, build+test green,
                           write a grounded CLAUDE.md, print a codebase map. --all does many.
  impact  [--week|--all]   What compass did for you: footguns blocked, files formatted,
                           spend by model, estimated \$ saved vs all-Opus.
  dashboard [--json|--html] Mission control: impact + spend + live fleet PR state in one
                           panel (reads ~/.compass + gh, read-only). --html writes a page.
  spend   [--week|--month|--today|--all] [--json] [--max-usd N]
                           Agent cost dashboard + budget gate. Set COMPASS_BUDGET_USD
                           for a soft warning ceiling; --max-usd N (or COMPASS_MAX_USD)
                           exits 2 with OVER_BUDGET when total exceeds N (CI/loop gate).
                           --today is the per-day circuit breaker for unattended loops.
  digest  [-n N] [--since D] [--all] [--json] [--mark REF] [--reset] [DIR]
                           Comprehension-rot guard: sample recently-merged changes you
                           didn't hand-write and explain each before reading the rationale.
                           Tracks what you've reviewed; reports how far your map has fallen
                           behind. Deterministic, local, read-only on the repo.
  schedule add|list|remove|run <routine>
                           Local scheduled agents (cron + claude -p): dep-refresh,
                           flaky-triage, doc-freshness, pr-babysit.
  route   "<task>"         Print the cheapest-correct model tier (experimental).
  bench   [--guardrail|--router|--json]
                           Reproducible scorecard: guardrail precision/recall + router
                           accuracy (deterministic, CI-gated). --sdlc <dir> for fix-rate.
  policy-synth [--from <glob>|-] [--min N]
                           Fleet brain: cluster recurring review findings into PROPOSED
                           CLAUDE.md rules (human reviews & merges; never auto-applied).
  sbom    [--no-audit|--gate|--json]
                           Dependency SBOM + native vuln audit (npm/pip/go/cargo/syft).
                           --gate exits non-zero on known vulns (CI/QA use).
  scan    [--staged|--diff|--all] [--injection] [PATH...]
                           Find secrets before they're committed (pre-commit / CI).
                           Built-in detectors gate; uses gitleaks for depth if present.
                           --injection also scans for prompt-injection / context poisoning.
  redteam [--eval|--scan] [--json]
                           Measure prompt-injection resistance: score the detectors
                           against the corpus (CI-gated) + scan this repo's untrusted
                           context (CLAUDE.md/AGENTS.md/READMEs · MCP · settings).
  verify  [vX.Y.Z|FILE]    Verify a release tarball's provenance (keyless SLSA
                           attestation built by release-sign.yml). Needs gh. No arg = latest.
  trace   emit|attach|show|verify [<commit>]
                           AI-code provenance: an open-spec Agent Trace record per commit
                           (changed ranges → tool/model/session), stored as a git note and
                           signed with cosign when available. Never blocks a commit.
  sandbox [--net allow] [--rw DIR] -- CMD...
                           Run CMD in a REAL OS sandbox (no network + writes confined to
                           cwd/tmp) via bwrap/firejail/sandbox-exec. For untrusted code.
  gate    [--port N|--status]
                           Localhost proxy that enforces COMPASS_MAX_USD for ANY agent
                           (Codex, Gemini, SDKs): point ANTHROPIC_BASE_URL/OPENAI_BASE_URL
                           at it; requests are refused once the cap is hit. Experimental.
  notify  "<message>"      DM your phone: Slack·Discord·Telegram·iMessage/WhatsApp
                           (set COMPASS_NOTIFY_URL/_TOKEN; --dry-run to preview).
  listen                   Run the command listener: act on /status /approve /hold /build
                           from your phone DM via Telegram (free) or an iMessage/WhatsApp bridge
                           (long-running daemon; needs gh + a configured transport).
  audit-log [--since D] [-n N] [--json]
                           The security trail: every blocked footgun (secret write,
                           dangerous command, scan hit) as a queryable JSONL record.
  doctor                   Validate the compass install (make doctor).
  release [vX.Y.Z|--dry-run]
                           Finish a release: push the tag, pin the Homebrew sha, publish the
                           GitHub Release (notes from CHANGELOG). Idempotent; needs gh.
  help                     This message.

Ledgers + config live in \${COMPASS_HOME:-~/.compass}. Everything is opt-in.
EOF
}

run() { local s="$SCRIPTS/compass-$1.sh"; shift; [ -x "$s" ] || { echo "compass: missing $s" >&2; exit 1; }; exec "$s" "$@"; }

case "$cmd" in
  quickstart) exec "$ROOT/quickstart.sh" "$@" ;;
  status)   run status "$@" ;;
  drift)    run drift "$@" ;;
  onboard)  run onboard "$@" ;;
  impact)   run impact "$@" ;;
  dashboard) run dashboard "$@" ;;
  spend)    run spend "$@" ;;
  digest)   run digest "$@" ;;
  schedule) run schedule "$@" ;;
  route)    run route "$@" ;;
  bench)    run bench "$@" ;;
  policy-synth) run policy-synth "$@" ;;
  sbom)     run sbom "$@" ;;
  scan)     run scan "$@" ;;
  redteam)  run redteam "$@" ;;
  verify)   exec "$SCRIPTS/verify-release.sh" "$@" ;;
  trace)    run trace "$@" ;;
  sandbox)  run sandbox "$@" ;;
  gate)     run gate "$@" ;;
  notify)   run notify "$@" ;;
  listen)   command -v node >/dev/null || { echo "compass listen: node required" >&2; exit 1; }; exec node "$SCRIPTS/compass-listen.mjs" "$@" ;;
  audit-log) run audit-log "$@" ;;
  doctor)   exec "$SCRIPTS/doctor.sh" "$@" ;;
  release)  exec "$SCRIPTS/release.sh" "$@" ;;
  -h|--help|help) usage ;;
  *) echo "compass: unknown command '$cmd'" >&2; echo; usage; exit 2 ;;
esac
